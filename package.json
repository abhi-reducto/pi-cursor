{
  "name": "pi-cursor",
  "version": "0.5.0",
  "description": "Use full-featured Pi (codemode, MCP, skills, AGENTS.md, custom tools) through your Cursor subscription",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhi-reducto/pi-cursor.git"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "cursor",
    "cursor-agent",
    "cursor-cli",
    "codemode",
    "mcp"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc",
    "test": "tsx --test $(find test -name '*.test.ts' -o -name '*.test.mts' -o -name '*.test.js' | sort)",
    "proto:generate": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-node": "^1.7.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@bufbuild/buf": "^1.65.0",
    "@bufbuild/protoc-gen-es": "1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.10.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": ">=0.52.10",
    "@mariozechner/pi-coding-agent": ">=0.52.10"
  }
}
